# Optional — defaults to http://127.0.0.1:8000 if unset. Only needed if your
# backend runs somewhere else (a different port, deployed URL, etc).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Required — Supabase Project Settings -> API. The anon/public key is safe
# here (not a secret — protected by RLS, see backend/supabase/schema.sql),
# but never put the service_role key in frontend code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
